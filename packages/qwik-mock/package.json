{
  "name": "@noma.to/qwik-mock",
  "version": "0.0.0-semantically-released",
  "description": "Small utility to mock Qwik QRLs",
  "repository": "https://github.com/ianlet/qwik-testing-library",
  "homepage": "https://github.com/ianlet/qwik-testing-library",
  "license": "MIT",
  "main": "./lib/index.mjs",
  "types": "./lib-types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib-types/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.cjs"
    }
  },
  "files": [
    "lib",
    "lib-types"
  ],
  "engines": {
    "node": "^22.0.0 || >=24.0.0"
  },
  "private": false,
  "type": "module",
  "scripts": {
    "build": "pnpm build.lib && pnpm build.types",
    "build.lib": "vite build --mode lib",
    "build.types": "tsc --emitDeclarationOnly",
    "check.types": "! grep -rlE \"@builder.io/qwik|@qwik.dev/core\" lib-types",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "validate": "pnpm build && pnpm check.types"
  },
  "devDependencies": {
    "@builder.io/qwik": "1.20.3",
    "@eslint/js": "10",
    "@qwik.dev/core": "2.0.0-rc.4",
    "@types/node": "22.20.5",
    "eslint": "10",
    "eslint-plugin-qwik": "2.0.0-rc.4",
    "globals": "^17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "undici": "*",
    "vite": "8.3.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "@builder.io/qwik": ">= 1.12.0 < 2",
    "@qwik.dev/core": ">= 2.0.0-rc.0 < 3",
    "vitest": ">= 3.0.0 < 5"
  },
  "peerDependenciesMeta": {
    "@builder.io/qwik": {
      "optional": true
    },
    "@qwik.dev/core": {
      "optional": true
    }
  }
}
